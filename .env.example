# =====================================================================
# Notification system configuration. Copy .env.example to .env and set
# real secrets.
# =====================================================================

# ---- Time zone ----
# OS time zone of every container. The source of truth is the 'timezone' key
# in the account_settings table (change it with PUT /api/v1/settings/timezone);
# services apply that value and warn when TZ differs from it.
TZ=Europe/Istanbul
TIMEZONE_WATCH_INTERVAL=30s

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=notifications
POSTGRES_USER=notifier
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_SSLMODE=disable

# Read-only role that executes user supplied audience SQL
AUDIENCE_DB_USER=audience_reader
AUDIENCE_DB_PASSWORD=change-me-audience

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=notifier
RABBITMQ_PASSWORD=change-me-rabbitmq

# ---- External provider ----
# webhook.site url that simulates the external provider
PROVIDER_URL=https://webhook.site/{{your-uuid}}
# Optional per channel overrides
SMS_PROVIDER_URL=
EMAIL_PROVIDER_URL=
PUSH_PROVIDER_URL=
PROVIDER_TIMEOUT=5s

# ---- Delivery / retry ----
SENDER_RATE_LIMIT_PER_SECOND=100
SENDER_MAX_RETRIES=3
SENDER_RETRY_DELAY=10m
MANAGER_BATCH_SIZE=100
MANAGER_POLL_INTERVAL=2s
MANAGER_WORKERS=4
# Delete notifications/deliveries/logs this many days after they finished (0 = keep forever)
MANAGER_RETENTION_DAYS=730

# ---- API rate limiting (per client IP) ----
# write = POST/PUT/DELETE under /api/, read = GET under /api/ and WebSocket
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_READ_RPS=20
API_RATE_LIMIT_READ_BURST=40
API_RATE_LIMIT_WRITE_RPS=5
API_RATE_LIMIT_WRITE_BURST=10
API_RATE_LIMIT_TRUST_PROXY=false

# ---- Observability ----
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318

# ---- Ports exposed on the host ----
PANEL_PORT=8080
